{
  "name": "tokenburnmarket",
  "version": "0.4.0",
  "description": "Connect your machine to tokenburnmarket: sync agent usage via ccusage, run the MCP server, place bets.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tokenburnmarket": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formidable-oss/tokenburnmarket.git",
    "directory": "packages/cli"
  },
  "homepage": "https://tokenburnmarket.vercel.app",
  "bugs": {
    "url": "https://github.com/formidable-oss/tokenburnmarket/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "claude-code",
    "codex",
    "ccusage",
    "token-usage",
    "prediction-market",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsup && vitest run --passWithNoTests",
    "build": "tsup",
    "prepublishOnly": "pnpm run check && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@tokenburnmarket/core": "workspace:*",
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  }
}
