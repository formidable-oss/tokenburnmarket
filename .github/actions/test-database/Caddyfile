{
  auto_https off
}
https://db.localtest.me:443, https://api.localtest.me:443 {
  tls /app/server.pem /app/server.key
  reverse_proxy https://localhost:4445 {
    transport http {
      tls_trusted_ca_certs /app/server.pem
      tls_server_name db.localtest.me
    }
    header_up Host db.localtest.me:4445
  }
}
