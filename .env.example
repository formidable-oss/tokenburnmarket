# Neon Postgres connection string. Used by the app and by drizzle-kit.
DATABASE_URL=
# Random 32+ byte string used to sign the session JWT: `openssl rand -base64 32`.
AUTH_SECRET=
# GitHub OAuth app. Callback URL: <NEXT_PUBLIC_APP_URL>/api/auth/callback/github.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Development only. When AUTH_GITHUB_ID is empty, /signin offers a local sign-in
# as this GitHub handle so you can work without an OAuth app. Ignored in production.
DEV_USER=
# Bearer secret Vercel Cron sends to /api/cron/mint, and the one a local
# `pnpm --filter @tokenburnmarket/web mint:run` sends. Any long random string:
# `openssl rand -hex 32`. Without it the mint endpoint answers 401 to everyone.
CRON_SECRET=
